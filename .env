# ============================================================================
# KONFIGURASI TELEGRAM REMOTE AGENT (Opsi A - Standalone Background Agent)
# ============================================================================

# 1. Buat Bot Baru di @BotFather (khusus untuk Remote Agent pribadi Anda)
TELEGRAM_BOT_TOKEN=ISI_TOKEN_BOT_BARU_DARI_BOTFATHER

# 2. Masukkan User Chat ID Pribadi Anda (Bukan ID Grup! Hanya ID ini yang diizinkan perintah)
# Cara cek: Chat ke @userinfobot di Telegram untuk melihat angka ID pribadi Anda
TELEGRAM_ALLOWED_CHAT_ID=ISI_CHAT_ID_PRIBADI_ANDA

# 3. PIN Keamanan Sesi (Wajib ketik /unlock <PIN> sebelum memberi perintah)
# Pesan /unlock Anda di Telegram akan otomatis dihapus dalam 1 detik agar tidak bisa diintip!
AGENT_PIN=8899

# 4. Durasi Sesi Aktif (dalam menit) sebelum otomatis terkunci kembali (Auto-Lock)
SESSION_TIMEOUT_MINUTES=15

# 5. Folder Kerja Default saat laptop pertama kali menyala
DEFAULT_WORKDIR=D:\Project Sistem\Project Web Apps\Update AI

# 6. Pagar Aman Folder (Pisahkan dengan titik koma ; )
# Anda bebas pindah folder (/cd) ke mana saja SELAMA masih di dalam pagar induk ini
ALLOWED_ROOTS=D:\;C:\Users\MSI GAMING\Documents;C:\Users\MSI GAMING\Desktop

# 7. Path ke Gemini CLI (Kosongkan jika ingin deteksi otomatis di Windows)
GEMINI_CLI_PATH=C:\Users\MSI GAMING\AppData\Roaming\npm\gemini.cmd
